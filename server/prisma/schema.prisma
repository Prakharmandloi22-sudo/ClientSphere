// ClientSphere CRM Database Schema (PostgreSQL)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_REP
  MARKETING
  SUPPORT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum OpportunityAccessLevel {
  READ
  WRITE
  ADMIN
}

enum OpportunityTeamRole {
  LEAD
  COLLABORATOR
  SPECIALIST
  VIEWER
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  STATUS_CHANGE
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW_SENSITIVE
  EXPORT
  STAGE_TRANSITION
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AutomationTrigger {
  LEAD_CREATED
  STAGE_CHANGED
  SCORE_UPDATED
  ACTIVITY_LOGGED
}

enum AutomationStatus {
  SUCCESS
  FAILED
  RETRYING
  ABORTED_LOOP
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  plan      String   @default("ENTERPRISE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  teams           Team[]
  leads           Lead[]
  companies       Company[]
  contacts        Contact[]
  opportunities   Opportunity[]
  pipelines       Pipeline[]
  activities      Activity[]
  auditLogs       AuditLog[]
  automationRules AutomationRule[]
  imports         Import[]
  integrations    Integration[]
  consents        Consent[]

  @@map("organizations")
}

model Team {
  id             String       @id @default(uuid())
  orgId          String       @map("org_id")
  name           String
  managerId      String?      @map("manager_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager        User?        @relation("TeamManager", fields: [managerId], references: [id])
  members        User[]       @relation("TeamMembers")

  @@map("teams")
}

model User {
  id           String        @id @default(uuid())
  orgId        String        @map("org_id")
  teamId       String?       @map("team_id")
  email        String        @unique
  passwordHash String        @map("password_hash")
  firstName    String        @map("first_name")
  lastName     String        @map("last_name")
  role         Role          @default(SALES_REP)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team         Team?         @relation("TeamMembers", fields: [teamId], references: [id])
  managedTeams Team[]        @relation("TeamManager")
  refreshTokens RefreshToken[]

  assignedLeads       Lead[]        @relation("LeadOwner")
  assignedCompanies   Company[]     @relation("CompanyOwner")
  assignedContacts    Contact[]     @relation("ContactOwner")
  assignedOpps        Opportunity[] @relation("OpportunityOwner")
  opportunityTeams    OpportunityTeam[]
  activitiesPerformed Activity[]    @relation("ActivityUser")
  auditLogs           AuditLog[]
  createdRules        AutomationRule[]
  imports             Import[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Lead {
  id              String       @id @default(uuid())
  orgId           String       @map("org_id")
  ownerId         String?      @map("owner_id")
  firstName       String       @map("first_name")
  lastName        String       @map("last_name")
  email           String
  normalizedEmail String       @map("normalized_email")
  phone           String?
  normalizedPhone String?      @map("normalized_phone")
  companyName     String?      @map("company_name")
  title           String?
  source          String       @default("MANUAL")
  status          LeadStatus   @default(NEW)
  score           Float        @default(0.0)
  scoreFactors    Json?        @map("score_factors")
  dedupKey        String       @map("dedup_key")
  customFields    Json?        @default("{}") @map("custom_fields")
  convertedAt     DateTime?    @map("converted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User?        @relation("LeadOwner", fields: [ownerId], references: [id])

  @@index([orgId, dedupKey])
  @@index([orgId, normalizedEmail])
  @@index([orgId, score])
  @@map("leads")
}

model Company {
  id            String           @id @default(uuid())
  orgId         String           @map("org_id")
  ownerId       String?          @map("owner_id")
  name          String
  domain        String?
  industry      String?
  annualRevenue Float?           @map("annual_revenue")
  employeeCount Int?             @map("employee_count")
  phone         String?
  address       String?
  dedupKey      String           @map("dedup_key")
  customFields  Json?            @default("{}") @map("custom_fields")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner         User?            @relation("CompanyOwner", fields: [ownerId], references: [id])
  contacts      CompanyContact[]
  opportunities Opportunity[]

  @@index([orgId, dedupKey])
  @@index([orgId, domain])
  @@map("companies")
}

model Contact {
  id              String           @id @default(uuid())
  orgId           String           @map("org_id")
  ownerId         String?          @map("owner_id")
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  email           String
  normalizedEmail String           @map("normalized_email")
  phone           String?
  title           String?
  dedupKey        String           @map("dedup_key")
  customFields    Json?            @default("{}") @map("custom_fields")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner         User?            @relation("ContactOwner", fields: [ownerId], references: [id])
  companies     CompanyContact[]
  opportunities Opportunity[]    @relation("PrimaryContact")

  @@index([orgId, dedupKey])
  @@index([orgId, normalizedEmail])
  @@map("contacts")
}

// Domain-Specific Challenge: Many-to-Many Contact <-> Company Join Table with Roles
model CompanyContact {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  contactId String   @map("contact_id")
  roleTitle String?  @map("role_title")
  isPrimary Boolean  @default(false) @map("is_primary")
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([companyId, contactId])
  @@index([companyId])
  @@index([contactId])
  @@map("company_contacts")
}

model Pipeline {
  id        String          @id @default(uuid())
  orgId     String          @map("org_id")
  name      String
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  organization  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid())
  pipelineId String   @map("pipeline_id")
  name       String
  stageOrder Int      @map("stage_order")
  probability Float   @default(0.1)
  isWon      Boolean  @default(false) @map("is_won")
  isLost     Boolean  @default(false) @map("is_lost")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, stageOrder])
  @@map("pipeline_stages")
}

// Domain-Specific Challenge: Opportunity Teams & Concurrency Control
model Opportunity {
  id               String            @id @default(uuid())
  orgId            String            @map("org_id")
  ownerId          String            @map("owner_id")
  pipelineId       String            @map("pipeline_id")
  stageId          String            @map("stage_id")
  companyId        String?           @map("company_id")
  primaryContactId String?           @map("primary_contact_id")
  name             String
  amount           Float             @default(0.0)
  currency         String            @default("USD")
  probability      Float             @default(0.1)
  closeDate        DateTime          @map("close_date")
  status           OpportunityStatus @default(OPEN)
  version          Int               @default(1) // Optimistic Concurrency Control
  customFields     Json?             @default("{}") @map("custom_fields")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner          User              @relation("OpportunityOwner", fields: [ownerId], references: [id])
  pipeline       Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage          PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContact Contact?          @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  teamMembers    OpportunityTeam[]

  @@index([orgId, stageId])
  @@index([orgId, ownerId])
  @@map("opportunities")
}

model OpportunityTeam {
  id              String                 @id @default(uuid())
  opportunityId   String                 @map("opportunity_id")
  userId          String                 @map("user_id")
  role            OpportunityTeamRole    @default(COLLABORATOR)
  accessLevel     OpportunityAccessLevel @default(READ) @map("access_level")
  splitPercentage Float                  @default(0.0) @map("split_percentage")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
  @@index([opportunityId])
  @@index([userId])
  @@map("opportunity_teams")
}

model Activity {
  id            String         @id @default(uuid())
  orgId         String         @map("org_id")
  performedById String         @map("performed_by_id")
  activityType  ActivityType   @map("activity_type")
  subject       String
  description   String?
  entityType    String         @map("entity_type") // LEAD, CONTACT, COMPANY, OPPORTUNITY
  entityId      String         @map("entity_id")
  scheduledAt   DateTime?      @map("scheduled_at")
  completedAt   DateTime?      @map("completed_at")
  status        ActivityStatus @default(COMPLETED)
  metadata      Json?          @default("{}")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  performedBy  User         @relation("ActivityUser", fields: [performedById], references: [id])

  @@index([orgId, entityType, entityId])
  @@index([orgId, performedById])
  @@map("activities")
}

model AuditLog {
  id         String      @id @default(uuid())
  orgId      String      @map("org_id")
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  changes    Json?       // Diff of old vs new values
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, entityType, entityId])
  @@index([orgId, userId])
  @@index([orgId, action])
  @@map("audit_logs")
}

model Import {
  id            String       @id @default(uuid())
  orgId         String       @map("org_id")
  uploadedById  String       @map("uploaded_by_id")
  entityType    String       @map("entity_type") // LEAD, CONTACT, COMPANY
  filename      String
  totalRows     Int          @default(0) @map("total_rows")
  processedRows Int          @default(0) @map("processed_rows")
  successRows   Int          @default(0) @map("success_rows")
  failedRows    Int          @default(0) @map("failed_rows")
  duplicateRows Int          @default(0) @map("duplicate_rows")
  status        ImportStatus @default(PENDING)
  errorReport   Json?        @map("error_report")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@map("imports")
}

model AutomationRule {
  id           String            @id @default(uuid())
  orgId        String            @map("org_id")
  createdById  String            @map("created_by_id")
  name         String
  description  String?
  triggerEvent AutomationTrigger @map("trigger_event")
  conditions   Json              @default("[]") // Array of { field, operator, value }
  actions      Json              @default("[]") // Array of { type, params }
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation(fields: [createdById], references: [id])
  executions   AutomationExecution[]

  @@map("automation_rules")
}

model AutomationExecution {
  id           String           @id @default(uuid())
  ruleId       String           @map("rule_id")
  entityType   String           @map("entity_type")
  entityId     String           @map("entity_id")
  triggerEvent String           @map("trigger_event")
  status       AutomationStatus @default(SUCCESS)
  retryCount   Int              @default(0) @map("retry_count")
  depthLevel   Int              @default(1) @map("depth_level") // Loop prevention depth
  payload      Json?
  result       Json?
  errorMessage String?          @map("error_message")
  executedAt   DateTime         @default(now()) @map("executed_at")

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, executedAt])
  @@index([entityType, entityId])
  @@map("automation_executions")
}

model Integration {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  provider  String   // EMAIL_SANDBOX, CALENDAR_SANDBOX, TELEPHONY_MOCK, WEBHOOK
  status    String   @default("CONNECTED") // CONNECTED, ERROR, DISCONNECTED
  config    Json     @default("{}") // Masked credentials, webhook URLs, secret keys
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
  @@map("integrations")
}

model Consent {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  entityType  String    @map("entity_type") // LEAD, CONTACT
  entityId    String    @map("entity_id")
  consentType String    @map("consent_type") // EMAIL_MARKETING, CALL_RECORDING, DATA_PROCESSING
  status      String    @default("GRANTED") // GRANTED, REVOKED
  grantedAt   DateTime  @default(now()) @map("granted_at")
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, entityType, entityId, consentType])
  @@map("consents")
}
