# ClientSphere Global Environment Configuration
# Copy to .env for local overrides. Never commit actual secret keys.

# System & Hosting
NODE_ENV=development
PORT=5000
CLIENT_PORT=3000
ANALYTICS_PORT=8000

# PostgreSQL Database
POSTGRES_USER=clientsphere_user
POSTGRES_PASSWORD=clientsphere_secure_pass_2026
POSTGRES_DB=clientsphere_db
DATABASE_URL=postgresql://clientsphere_user:clientsphere_secure_pass_2026@localhost:5432/clientsphere_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=clientsphere-super-secret-jwt-key-change-in-production-2026
REFRESH_SECRET=clientsphere-refresh-secret-key-change-in-prod-2026

# External Integrations Mock Sandbox Keys
TELEPHONY_WEBHOOK_SECRET=clientsphere-telephony-secret-2026
EMAIL_SANDBOX_API_KEY=sandbox-email-key-clientsphere
PYTHON_ANALYTICS_URL=http://localhost:8000
